{
  "folders": [
    {
      "name": "StrideGuard",
      "path": "."
    }
  ],
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "App: dev",
        "type": "npm",
        "script": "dev",
        "problemMatcher": [],
        "path": "app"
      },
      {
        "label": "App: build",
        "type": "npm",
        "script": "build",
        "group": "build",
        "problemMatcher": "$tsc",
        "path": "app"
      },
      {
        "label": "App: test",
        "type": "npm",
        "script": "test",
        "group": "test",
        "problemMatcher": [],
        "path": "app"
      }
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "App: Chrome (start dev server first)",
        "type": "chrome",
        "request": "launch",
        "url": "http://localhost:4173",
        "webRoot": "${workspaceFolder}/app/src"
      }
    ]
  },
  "settings": {
    "terminal.integrated.cwd": "${workspaceFolder}/app"
  }
}
